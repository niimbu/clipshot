<Window x:Class="ClipShot.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="False"
        Cursor="Cross" Background="#99000000">
    <Grid>
        <Image x:Name="ScreenshotImage" Stretch="Fill"/>
        <Canvas x:Name="SelectionCanvas" Background="Transparent"
                MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
                MouseMove="SelectionCanvas_MouseMove"
                MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp"
                MouseRightButtonDown="SelectionCanvas_MouseRightButtonDown">
            <Rectangle x:Name="SelectionRect" Visibility="Collapsed"
                       Stroke="#FFFFFF" StrokeThickness="2"
                       Fill="#223978F6"/>
        </Canvas>
        <Border x:Name="HintBorder" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,28,0,0" Background="#DD202124" CornerRadius="8"
                Padding="16,9" IsHitTestVisible="False">
            <TextBlock Text="Drag to select an area  ·  Esc to cancel"
                       Foreground="White" FontSize="13"/>
        </Border>
        <Border x:Name="ActionsBar" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,24,0,0" Padding="8" CornerRadius="10"
                Background="#F0202124" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button Content="Copy" Click="CopySelected_Click" MinWidth="76"
                        Padding="14,8" Margin="2" Background="#FF3978F6"
                        Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Save PNG" Click="SaveSelected_Click" MinWidth="88"
                        Padding="14,8" Margin="2" Background="#FF34363A"
                        Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Cancel" Click="CancelSelection_Click" MinWidth="76"
                        Padding="14,8" Margin="2" Background="#FF34363A"
                        Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
