<Window x:Class="ClipShot.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True"
        Cursor="Cross"
        Background="Black"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded">
    <Grid>
        <Image x:Name="ScreenshotImage" Stretch="Fill"/>
        <Canvas x:Name="SelectionCanvas"
                Background="Transparent"
                SizeChanged="SelectionCanvas_SizeChanged"
                MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
                MouseMove="SelectionCanvas_MouseMove"
                MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp"
                MouseRightButtonDown="SelectionCanvas_MouseRightButtonDown">
            <Rectangle x:Name="DimFull" Fill="#8A000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="DimTop" Fill="#8A000000" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Rectangle x:Name="DimLeft" Fill="#8A000000" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Rectangle x:Name="DimRight" Fill="#8A000000" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Rectangle x:Name="DimBottom" Fill="#8A000000" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border x:Name="SelectionRect"
                    Visibility="Collapsed"
                    BorderBrush="White"
                    BorderThickness="1.5"
                    CornerRadius="2"
                    Background="#18FFFFFF"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="0.55"/>
                </Border.Effect>
            </Border>
            <Border x:Name="SizeBadge"
                    Visibility="Collapsed"
                    Background="#F216181D"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="8,4"
                    IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
            </Border>
            <Border x:Name="ActionsBar"
                    Visibility="Collapsed"
                    Background="#F216181D"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="4"
                    MouseLeftButtonDown="ActionsBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Button Margin="2,0" Click="CopySelected_Click" Style="{StaticResource OverlayPrimaryButton}" ToolTip="Copy the selection" AutomationProperties.Name="Copy selection">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Copy" VerticalAlignment="Center"/>
                            <TextBlock Text="Enter" Margin="8,0,0,0" Opacity="0.45" FontSize="11" FontWeight="Normal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="2,0" Click="SaveSelected_Click" Style="{StaticResource OverlayGhostButton}" ToolTip="Save the selection as a PNG" AutomationProperties.Name="Save selection as PNG">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Save PNG" VerticalAlignment="Center"/>
                            <TextBlock Text="Ctrl S" Margin="8,0,0,0" Opacity="0.55" FontSize="11" FontWeight="Normal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="2,0" Click="CancelSelection_Click" Style="{StaticResource OverlayGhostButton}" ToolTip="Discard the selection" AutomationProperties.Name="Cancel selection">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                            <TextBlock Text="Esc" Margin="8,0,0,0" Opacity="0.55" FontSize="11" FontWeight="Normal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>
        <Border x:Name="HintBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,28,0,0"
                Background="#F216181D"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="999"
                Padding="16,8"
                IsHitTestVisible="False">
            <TextBlock Text="Drag to select an area    ·    Esc cancels"
                       Foreground="White"
                       FontSize="13"/>
        </Border>
    </Grid>
</Window>
