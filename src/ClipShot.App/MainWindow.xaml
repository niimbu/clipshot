 <Window x:Class="ClipShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipShot" Height="770" Width="900" MinHeight="700" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="#F6F7F9">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="ClipShot" FontSize="28" FontWeight="SemiBold" Foreground="#202124"/>
                <TextBlock Text="A clear, quick way to capture what’s on your screen." Margin="0,5,0,0" FontSize="13" Foreground="#777B82"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E9F0FF" CornerRadius="20" Padding="12,6">
                <TextBlock Text="EARLY ACCESS" FontSize="10" FontWeight="SemiBold" Foreground="#3269D6"/>
            </Border>
        </Grid>

        <Border x:Name="UpdateNoticePanel" Grid.Row="1" Visibility="Collapsed" Background="#EAF2FF" BorderBrush="#C9DAFF" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="UpdateNowButton" Content="Update now" DockPanel.Dock="Right" Click="UpdateNow_Click" Padding="12,6" Background="#3978F6" Foreground="White" BorderBrush="#3978F6"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateNoticeTitle" Text="A new version of ClipShot is available" FontWeight="SemiBold" Foreground="#244A91"/>
                    <TextBlock x:Name="UpdateNoticeDetails" Text="A newer version is ready. Update now or keep using this version." FontSize="11" Foreground="#536987" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="White" CornerRadius="18" BorderBrush="#E8EAEE" BorderThickness="1" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="New capture" FontSize="18" FontWeight="SemiBold" Foreground="#202124"/>
                    <TextBlock Text="Choose what you want to capture." Margin="0,5,0,0" FontSize="12" Foreground="#777B82"/>
                </StackPanel>

                <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F8F9FB" CornerRadius="14" Padding="22">
                        <StackPanel>
                            <Border Width="46" Height="46" Background="#EAF0FF" CornerRadius="12" HorizontalAlignment="Left">
                                <TextBlock Text="▧" FontSize="24" Foreground="#3978F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Full screen" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0" Foreground="#202124"/>
                            <TextBlock Text="Capture your primary display." FontSize="12" Foreground="#777B82" Margin="0,5,0,18"/>
                            <Button Content="Capture screen" HorizontalAlignment="Left" Click="CaptureScreen_Click" Background="#3978F6" Foreground="White" BorderBrush="#3978F6"/>
                            <Button Content="Save screen as PNG" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SaveScreen_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#F8F9FB" CornerRadius="14" Padding="22">
                        <StackPanel>
                            <Border Width="46" Height="46" Background="#EAF0FF" CornerRadius="12" HorizontalAlignment="Left">
                                <TextBlock Text="⌗" FontSize="24" Foreground="#3978F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Select a region" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0" Foreground="#202124"/>
                            <TextBlock Text="Drag to capture a specific area." FontSize="12" Foreground="#777B82" Margin="0,5,0,18"/>
                            <Button Content="Select region" HorizontalAlignment="Left" Click="CaptureRegion_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="#F7F8FA" CornerRadius="9" Padding="12,10">
                    <DockPanel>
                        <TextBlock Text="Tip" FontWeight="SemiBold" Foreground="#3978F6" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                        <TextBlock Text="Your capture is copied to the clipboard automatically." Foreground="#777B82" FontSize="12"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3" Background="#FBFCFE" BorderBrush="#E8EAEE" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Keyboard shortcuts" FontSize="14" FontWeight="SemiBold" Foreground="#202124"/>
                                <TextBlock Text="Click a field and press your preferred key combination." FontSize="11" Foreground="#777B82" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Reset" Padding="12,7" Margin="0,0,8,0" Click="ResetHotkeys_Click"/>
                                <Button Content="Save shortcuts" Padding="14,7" Background="#3978F6" Foreground="White" BorderBrush="#3978F6" Click="SaveHotkeys_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SELECT REGION" FontSize="9" FontWeight="SemiBold" Foreground="#777B82" Margin="0,0,0,6"/>
                                <TextBox x:Name="RegionHotkeyBox" IsReadOnly="True" Focusable="True" PreviewKeyDown="RegionHotkeyBox_PreviewKeyDown" Padding="10,8" FontSize="12" BorderBrush="#DDE1E7" Background="White"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="FULL SCREEN" FontSize="9" FontWeight="SemiBold" Foreground="#777B82" Margin="0,0,0,6"/>
                                <TextBox x:Name="FullScreenHotkeyBox" IsReadOnly="True" Focusable="True" PreviewKeyDown="FullScreenHotkeyBox_PreviewKeyDown" Padding="10,8" FontSize="12" BorderBrush="#DDE1E7" Background="White"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Background="#FBFCFE" BorderBrush="#E8EAEE" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Preferences" FontSize="14" FontWeight="SemiBold" Foreground="#202124"/>
                        <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start ClipShot when I sign in to Windows" Margin="0,10,0,0" FontSize="12" Foreground="#42464D" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>
                        <TextBlock Text="ClipShot will open automatically when you sign in, with your screenshot shortcuts ready." FontSize="11" Foreground="#777B82" Margin="22,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border></ScrollViewer>

        <DockPanel Grid.Row="4" Margin="2,14,2,0">
            <TextBlock Text="CLIPSHOT  ·  WINDOWS" FontSize="10" Foreground="#9A9EA5" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Text="Ready when you are" FontSize="11" Foreground="#777B82" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>