<Window x:Class="ClipShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipShot"
        Width="700"
        SizeToContent="Height"
        MinWidth="660"
        MaxWidth="700"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="28,26,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="10" Margin="0,1,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#54AE6F" Offset="0"/>
                            <GradientStop Color="#00AA4F" Offset="0.5"/>
                            <GradientStop Color="#007736" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Fill="White"
                              Data="M8,1.2 A6.8,6.8 0 1 1 7.99,1.2 Z M3.2,4.2 H12.8 V10.8 H11.8 V5.2 H4.2 V10.8 H3.2 Z M5.6,8.4 L7.2,6.8 8,7.6 6.4,9.2 Z M10.2,6.6 L7.6,9.2 8.4,10 11,7.4 Z"/>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ClipShot" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="Capture a region, or the whole screen." Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border x:Name="UpdateNoticePanel"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="#EEF3FF"
                BorderBrush="#D5E1FF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12"
                Margin="0,16,0,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="UpdateNowButton"
                        Content="Update now"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Padding="14,9"
                        HorizontalContentAlignment="Center"
                        Click="UpdateNow_Click"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateNoticeTitle" Text="A new version is available" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock x:Name="UpdateNoticeDetails" Text="Update now, or keep using this version." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ActionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource KeycapBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Region" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,14,0,0"/>
                    <TextBlock Grid.Row="2" Text="Drag around the area you want. Annotation tools open next." TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" LineHeight="18" MinHeight="36"/>
                    <Button Grid.Row="3" Margin="0,16,0,0" Click="CaptureRegion_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Select region">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="RegionHotkeyHint" DockPanel.Dock="Right" Opacity="0.62" FontWeight="Normal" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="130" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Select region" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ActionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource KeycapBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Stroke="{StaticResource InkBrush}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M3,5 H21 V15 H3 Z M8,18 H16 M12,15 V18"/>
                            </Viewbox>
                        </Border>
                        <Button Content="Save PNG" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource QuietButton}" Click="SaveScreen_Click"
                                ToolTip="Save the full screen as a PNG file"
                                AutomationProperties.Name="Save screen as PNG"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="Full screen" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,14,0,0"/>
                    <TextBlock Grid.Row="2" Text="Grab the primary display, then annotate, copy, or save." TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" LineHeight="18" MinHeight="36"/>
                    <Button Grid.Row="3" Margin="0,16,0,0" Click="CaptureScreen_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Capture screen">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="ScreenHotkeyHint" DockPanel.Dock="Right" Opacity="0.62" FontWeight="Normal" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="130" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Capture screen" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="5" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Shortcuts" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Click a field, then press a combination. It saves immediately." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Reset" VerticalAlignment="Top" Style="{StaticResource QuietButton}" Click="ResetHotkeys_Click" AutomationProperties.Name="Reset shortcuts"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="RegionHotkeyCaption" Text="Region" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,6"/>
                        <TextBox x:Name="RegionHotkeyBox"
                                 Style="{StaticResource HotkeyBox}"
                                 ToolTip="Click, then press the keys you want for region capture"
                                 PreviewKeyDown="RegionHotkeyBox_PreviewKeyDown"
                                 GotFocus="HotkeyBox_GotFocus"
                                 LostFocus="HotkeyBox_LostFocus"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="ScreenHotkeyCaption" Text="Full screen" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,6"/>
                        <TextBox x:Name="FullScreenHotkeyBox"
                                 Style="{StaticResource HotkeyBox}"
                                 ToolTip="Click, then press the keys you want for full-screen capture"
                                 PreviewKeyDown="FullScreenHotkeyBox_PreviewKeyDown"
                                 GotFocus="HotkeyBox_GotFocus"
                                 LostFocus="HotkeyBox_LostFocus"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              Content="Start ClipShot in the tray when I sign in to Windows"
                              FontSize="12.5"
                              Foreground="{StaticResource InkBrush}"
                              Checked="StartWithWindows_Changed"
                              Unchecked="StartWithWindows_Changed"/>
                    <DockPanel Margin="0,14,0,0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Region dim"
                                   FontSize="12.5"
                                   Foreground="{StaticResource InkBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock x:Name="DimOpacityValueText"
                                   DockPanel.Dock="Right"
                                   Text="45%"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   MinWidth="36"
                                   TextAlignment="Right"/>
                        <Slider x:Name="DimOpacitySlider"
                                Minimum="0"
                                Maximum="90"
                                Value="45"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ToolTip="Opacity of the dimmed area outside your region (0% = clear, 90% = very dark)"
                                ValueChanged="DimOpacitySlider_ValueChanged"/>
                    </DockPanel>
                    <TextBlock Text="0% leaves the outside fully visible; higher values darken everything outside the selection."
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="6" Margin="2,16,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="by niimbu" FontSize="11" Foreground="#A0A4AB" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="CheckForUpdatesButton"
                    Grid.Column="1"
                    Content="Check for updates"
                    Style="{StaticResource SecondaryButton}"
                    Padding="12,8"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Click="CheckForUpdates_Click"
                    AutomationProperties.Name="Check for updates"/>
        </Grid>
    </Grid>
</Window>
