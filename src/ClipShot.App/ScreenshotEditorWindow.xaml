<Window x:Class="ClipShot.ScreenshotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipShot — Screenshot" Width="1120" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="White" CornerRadius="12" Padding="10" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Top" VerticalAlignment="Center">
                    <Button Content="Pen" Click="Pen_Click" Margin="0,0,5,5"/>
                    <Button Content="Highlight" Click="Highlight_Click" Margin="0,0,5,5"/>
                    <Button Content="Arrow" Click="Arrow_Click" Margin="0,0,5,5"/>
                    <Button Content="Line" Click="Line_Click" Margin="0,0,5,5"/>
                    <Button Content="Rectangle" Click="Rectangle_Click" Margin="0,0,5,5"/>
                    <Button Content="Ellipse" Click="Ellipse_Click" Margin="0,0,5,5"/>
                    <Button Content="Text" Click="Text_Click" Margin="0,0,5,5"/>
                    <Button Content="Number" Click="Number_Click" Margin="0,0,5,5"/>
                    <Button Content="Blur" Click="Blur_Click" Margin="0,0,5,5"/>
                    <Button Content="Pixelate" Click="Pixelate_Click" Margin="0,0,5,5"/>
                    <Button Content="Erase" Click="Erase_Click" Margin="0,0,5,5"/>
                    <Button Content="Undo" Click="Undo_Click" Margin="0,0,5,5"/>
                    <Button Content="Redo" Click="Redo_Click" Margin="0,0,12,5"/>
                    <Button Content="Copy" Click="Copy_Click" Background="#3978F6" Foreground="White" BorderBrush="#3978F6" Margin="0,0,5,5"/>
                    <Button Content="Save PNG" Click="Save_Click" Margin="0,0,5,5"/>
                    <Button Content="Close" Click="Close_Click" Margin="0,0,0,5"/>
                </WrapPanel>
                <TextBlock Text="Choose a tool, then draw or select an area on your screenshot." Foreground="#777B82"
                           VerticalAlignment="Center" Margin="2,4,0,0"/>
            </DockPanel>
        </Border>
        <Border Background="#FFF9F2" BorderBrush="#E9A66B" BorderThickness="2" CornerRadius="12" Padding="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="PreviewSurface" Background="#FFF9F2">
                    <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <InkCanvas x:Name="AnnotationCanvas" Background="Transparent" EditingMode="Ink"
                               DefaultDrawingAttributes="{x:Null}" MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                               MouseMove="AnnotationCanvas_MouseMove" MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp"
                               StrokeCollected="AnnotationCanvas_StrokeCollected"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>