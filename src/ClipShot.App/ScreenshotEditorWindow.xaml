<Window x:Class="ClipShot.ScreenshotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipShot" Width="1040" Height="720" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="#EEF1F5"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="EditorToolButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="Foreground" Value="#343A40"/>
            <Setter Property="BorderBrush" Value="#E7EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="White" CornerRadius="10" Padding="7" Margin="0,0,0,8" BorderBrush="#E7EAF0" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Top" VerticalAlignment="Center">
                    <Button Click="Pen_Click" ToolTip="Pen" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Highlight_Click" ToolTip="Highlight" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xEA3F;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Arrow_Click" ToolTip="Arrow" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Line_Click" ToolTip="Line" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xEADF;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Rectangle_Click" ToolTip="Rectangle" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE739;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Ellipse_Click" ToolTip="Ellipse" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xEA3A;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Text_Click" ToolTip="Text" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Number_Click" ToolTip="Numbered step" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Blur_Click" ToolTip="Blur" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Pixelate_Click" ToolTip="Pixelate" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Erase_Click" ToolTip="Erase strokes" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Select_Click" ToolTip="Select and move annotations" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE762;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="DeleteSelection_Click" ToolTip="Delete selected annotation" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Copy_Click" ToolTip="Copy screenshot" Style="{StaticResource EditorToolButton}" Background="#3978F6" Foreground="White"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Save_Click" ToolTip="Save PNG" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"/></Button>
                    <Button Click="Close_Click" ToolTip="Close editor" Style="{StaticResource EditorToolButton}"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets"/></Button>
                </WrapPanel>
                <TextBlock Text="SPACE  Copy &amp; close     ·     Ctrl+Z  Undo     ·     Ctrl+Y  Redo" Foreground="#858B95"
                           FontSize="11" VerticalAlignment="Center" Margin="3,3,0,0"/>
            </DockPanel>
        </Border>
        <Border Background="#E8ECF2" BorderBrush="#DDE2E9" BorderThickness="1" CornerRadius="10" Padding="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="PreviewSurface" Background="White">
                    <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <InkCanvas x:Name="AnnotationCanvas" Background="Transparent" EditingMode="Ink"
                               PreviewMouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                               PreviewMouseMove="AnnotationCanvas_MouseMove" PreviewMouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp"
                               StrokeCollected="AnnotationCanvas_StrokeCollected"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </DockPanel>

</Window>