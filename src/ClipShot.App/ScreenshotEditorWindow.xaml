<Window x:Class="ClipShot.ScreenshotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipShot"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#D9101216"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="EditorToolButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F2F4F7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#28FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3AFFFFFF"/>
                </Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#F4F5F7"/>
                    <Setter Property="Foreground" Value="#16181D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditorPrimaryToolButton" TargetType="Button" BasedOn="{StaticResource EditorToolButton}">
            <Setter Property="Background" Value="#F4F5F7"/>
            <Setter Property="Foreground" Value="#16181D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="Foreground" Value="#16181D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D9DCE2"/>
                    <Setter Property="Foreground" Value="#16181D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditorToolDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent"
                      Padding="24,24,24,96">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#0A0C10"
                        CornerRadius="4"
                        Padding="1"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.45" Color="Black"/>
                    </Border.Effect>
                    <Grid x:Name="PreviewSurface" Background="White" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <InkCanvas x:Name="AnnotationCanvas"
                                   Background="Transparent"
                                   EditingMode="Ink"
                                   PreviewMouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                                   PreviewMouseMove="AnnotationCanvas_MouseMove"
                                   PreviewMouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp"
                                   StrokeCollected="AnnotationCanvas_StrokeCollected"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                Background="#F216181D"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                Padding="8,6"
                IsHitTestVisible="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.4" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PenButton" Click="Pen_Click" ToolTip="Pen" Style="{StaticResource EditorToolButton}" Tag="Active" AutomationProperties.Name="Pen">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button x:Name="HighlightButton" Click="Highlight_Click" ToolTip="Highlight" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Highlight">
                    <TextBlock Text="&#xEA3F;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button x:Name="ArrowButton" Click="Arrow_Click" ToolTip="Arrow" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Arrow">
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button x:Name="LineButton" Click="Line_Click" ToolTip="Line" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Line">
                    <TextBlock Text="&#xEADF;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button x:Name="RectangleButton" Click="Rectangle_Click" ToolTip="Rectangle" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Rectangle">
                    <TextBlock Text="&#xE739;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button x:Name="EllipseButton" Click="Ellipse_Click" ToolTip="Ellipse" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Ellipse">
                    <TextBlock Text="&#xEA3A;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button x:Name="TextButton" Click="Text_Click" ToolTip="Text" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Text">
                    <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button x:Name="NumberButton" Click="Number_Click" ToolTip="Numbered step" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Numbered step">
                    <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Border Style="{StaticResource EditorToolDivider}"/>
                <Button x:Name="BlurButton" Click="Blur_Click" ToolTip="Blur" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Blur">
                    <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button x:Name="PixelateButton" Click="Pixelate_Click" ToolTip="Pixelate" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Pixelate">
                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button x:Name="EraseButton" Click="Erase_Click" ToolTip="Erase" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Erase">
                    <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button x:Name="SelectButton" Click="Select_Click" ToolTip="Select" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Select">
                    <TextBlock Text="&#xE762;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button Click="DeleteSelection_Click" ToolTip="Delete selection" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Delete selection">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Border Style="{StaticResource EditorToolDivider}"/>
                <Button Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Undo">
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Redo">
                    <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Border Style="{StaticResource EditorToolDivider}"/>
                <Button Click="Copy_Click" ToolTip="Copy and close (Space)" Style="{StaticResource EditorPrimaryToolButton}" AutomationProperties.Name="Copy" Width="Auto" MinWidth="72" Padding="12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                        <TextBlock Text="Copy" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="Save_Click" ToolTip="Save PNG" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Save PNG">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button Click="Close_Click" ToolTip="Close (Esc)" Style="{StaticResource EditorToolButton}" AutomationProperties.Name="Close editor">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
